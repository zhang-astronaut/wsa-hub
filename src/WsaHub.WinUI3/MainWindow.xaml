<Window
    x:Class="WsaHub.WinUI3.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="WsaHub">
    <NavigationView IsBackButtonVisible="Collapsed" PaneDisplayMode="Left" IsSettingsVisible="True">
        <NavigationView.MenuItems>
            <NavigationViewItem Content="首页" Tag="home" />
            <NavigationViewItem Content="更新与安装" Tag="update" />
            <NavigationViewItem Content="APK / ADB" Tag="adb" />
            <NavigationViewItem Content="应用管理" Tag="apps" />
            <NavigationViewItem Content="备份" Tag="backup" />
            <NavigationViewItem Content="日志" Tag="logs" />
        </NavigationView.MenuItems>
        <Frame x:Name="ContentFrame" Margin="16" />
    </NavigationView>
</Window>
