<Window
    x:Class="WsaHub.WinUI3.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="WsaHub">
    <NavigationView x:Name="Nav" IsBackButtonVisible="Collapsed" PaneDisplayMode="Left" IsSettingsVisible="False" ItemInvoked="Nav_ItemInvoked">
        <NavigationView.MenuItems>
            <NavigationViewItem Content="首页" Tag="home" IsSelected="True" />
            <NavigationViewItem Content="更新与安装" Tag="update" />
            <NavigationViewItem Content="APK / ADB" Tag="adb" />
            <NavigationViewItem Content="应用管理" Tag="apps" />
            <NavigationViewItem Content="备份" Tag="backup" />
            <NavigationViewItem Content="设置" Tag="settings" />
            <NavigationViewItem Content="日志" Tag="logs" />
        </NavigationView.MenuItems>
        <Grid RowDefinitions="Auto,*">
            <Border x:Name="StatusBar" Padding="16,10" Background="#2A2A30">
                <TextBlock x:Name="StatusText" Text="正在检测 WSA…" Foreground="#D0D0D8" />
            </Border>
            <Frame x:Name="ContentFrame" Grid.Row="1" Margin="12" />
        </Grid>
    </NavigationView>
</Window>
